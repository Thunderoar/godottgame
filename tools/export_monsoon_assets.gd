extends Node
## Explicit export of editable production-sized PNGs, with pivots and provenance.
func _ready() -> void:
	if not TestEnvironment.require_isolation(): get_tree().quit(1); return
	var output := OS.get_environment("MONSOON_ASSET_OUTPUT")
	if output.is_empty():
		push_error("Set MONSOON_ASSET_OUTPUT to an explicit destination before exporting original artwork.")
		get_tree().quit(1)
		return
	DirAccess.make_dir_recursive_absolute(output)
	var entries: Dictionary = {}
	for family in MonsoonArt.TREE_SIZES.size():
		for part in ["whole", "upper", "lower"]:
			_store(output, "tree_%d_%s" % [family, part], MonsoonArt.tree_texture(family, part), entries)
	for level in range(1, 6): _store(output, "house_%d" % level, PixelArt.house_texture(level), entries)
	for variant in 6: _store(output, "undergrowth_%d" % variant, PixelArt.coastal_grass(variant), entries)
	for kind in ["fishing_net", "timber", "bucket", "lantern", "planter", "baskets"]:
		_store(output, kind, MonsoonArt.prop(kind), entries)
	for kind in ["potion", "equipment", "pet", "house"]:
		_store(output, "stall_" + kind, PixelArt.stall_texture(kind), entries)
	var file := FileAccess.open(output.path_join("manifest.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify({"source": "Original artwork generated by scripts/creative/monsoon_art.gd and scripts/core/pixel_art.gd", "palette": WorldPalette.current().title, "scale": PixelArt.PX, "entries": entries}, "\t"))
	print("MONSOON ASSETS: ", entries.size(), " PNGs exported with pivots")
	get_tree().quit()

func _store(output: String, id: String, texture: Texture2D, entries: Dictionary) -> void:
	var result := texture.get_image().save_png(output.path_join(id + ".png"))
	assert(result == OK)
	var size := texture.get_size()
	var pivot_y := int(size.y)
	if id.begins_with("tree_") and id.ends_with("_upper"):
		pivot_y = MonsoonArt.TREE_SIZES[int(id.split("_")[1])].y
	entries[id] = {"file": id + ".png", "size": [int(size.x), int(size.y)], "pivot": [int(size.x / 2), pivot_y], "filter": "nearest", "frames": 1}
